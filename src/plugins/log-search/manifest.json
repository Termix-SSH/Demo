{
  "id": "log-search",
  "name": "Log Search",
  "version": "1.0.0",
  "description": "Search logs from the journal, log files and Docker containers across many hosts at once.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Log-Search",
  "docs": "https://docs.termix.site/plugins/log-search",
  "category": "Infrastructure",
  "icon": "ScrollText",
  "features": [
    "Search the systemd journal, log files and Docker logs on many hosts at once",
    "Plain text or regular expression search with a time range and level filter",
    "One merged result list with a status line for every host",
    "Live search over SSH, nothing is stored or indexed",
    "A search action for Operations, the assistant and the CLI"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.11.1-0",
    "api": "^1.15"
  },
  "capabilities": [
    "hosts:read",
    "credentials:use",
    "credentials:read",
    "ssh:connect",
    "network:serve",
    "ui:surface",
    "operations:provide"
  ],
  "contributes": {
    "tabs": [
      {
        "id": "log-search",
        "titleKey": "tab.title",
        "icon": "ScrollText",
        "openFrom": ["rail", "palette"]
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "host": {
        "enableKey": "enableLogSearch",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "enableDefault": true,
        "editorGroup": "ssh",
        "fields": [
          {
            "key": "useSudo",
            "type": "boolean",
            "labelKey": "settings.host.useSudo.label",
            "descriptionKey": "settings.host.useSudo.description",
            "default": true,
            "requires": "enableLogSearch"
          },
          {
            "key": "logPaths",
            "type": "string",
            "labelKey": "settings.host.logPaths.label",
            "descriptionKey": "settings.host.logPaths.description",
            "placeholderKey": "settings.host.logPaths.placeholder",
            "default": "",
            "requires": "enableLogSearch"
          },
          {
            "key": "showPanel",
            "type": "boolean",
            "labelKey": "settings.host.showPanel.label",
            "descriptionKey": "settings.host.showPanel.description",
            "default": true,
            "requires": "enableLogSearch"
          }
        ]
      },
      "user": [
        {
          "key": "companionAutoOpen",
          "labelKey": "settings.user.companionAutoOpen.label",
          "descriptionKey": "settings.user.companionAutoOpen.description",
          "type": "boolean",
          "default": false
        },
        {
          "key": "companionSide",
          "labelKey": "settings.user.companionSide.label",
          "descriptionKey": "settings.user.companionSide.description",
          "type": "select",
          "default": "right",
          "options": [
            {
              "value": "right",
              "labelKey": "settings.user.companionSide.right"
            },
            {
              "value": "left",
              "labelKey": "settings.user.companionSide.left"
            },
            {
              "value": "bottom",
              "labelKey": "settings.user.companionSide.bottom"
            }
          ]
        },
        {
          "key": "companionSize",
          "labelKey": "settings.user.companionSize.label",
          "descriptionKey": "settings.user.companionSize.description",
          "type": "number",
          "min": 240,
          "max": 900,
          "default": 420
        },
        {
          "key": "companionEdgeButton",
          "labelKey": "settings.user.companionEdgeButton.label",
          "descriptionKey": "settings.user.companionEdgeButton.description",
          "type": "boolean",
          "default": true
        }
      ]
    },
    "operations": {
      "actions": [
        {
          "id": "log-search.search",
          "titleKey": "operations.search.title",
          "icon": "ScrollText",
          "scope": "server",
          "risk": "read",
          "permission": "use",
          "inputs": [
            {
              "key": "query",
              "type": "string",
              "labelKey": "operations.search.query",
              "required": true
            },
            {
              "key": "range",
              "type": "select",
              "labelKey": "operations.search.range",
              "default": "1h",
              "options": [
                {
                  "value": "15m",
                  "labelKey": "range.15m"
                },
                {
                  "value": "1h",
                  "labelKey": "range.1h"
                },
                {
                  "value": "6h",
                  "labelKey": "range.6h"
                },
                {
                  "value": "24h",
                  "labelKey": "range.24h"
                },
                {
                  "value": "7d",
                  "labelKey": "range.7d"
                }
              ]
            },
            {
              "key": "source",
              "type": "select",
              "labelKey": "operations.search.source",
              "default": "all",
              "options": [
                {
                  "value": "all",
                  "labelKey": "source.all"
                },
                {
                  "value": "journal",
                  "labelKey": "source.journal"
                },
                {
                  "value": "files",
                  "labelKey": "source.files"
                },
                {
                  "value": "docker",
                  "labelKey": "source.docker"
                }
              ]
            },
            {
              "key": "level",
              "type": "select",
              "labelKey": "operations.search.level",
              "default": "all",
              "options": [
                {
                  "value": "all",
                  "labelKey": "level.all"
                },
                {
                  "value": "warn",
                  "labelKey": "level.warn"
                },
                {
                  "value": "error",
                  "labelKey": "level.error"
                }
              ]
            },
            {
              "key": "limit",
              "type": "number",
              "labelKey": "operations.search.limit",
              "min": 1,
              "max": 200,
              "default": 50
            }
          ],
          "outputs": [
            {
              "key": "text",
              "type": "textarea",
              "labelKey": "operations.search.text"
            }
          ],
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
