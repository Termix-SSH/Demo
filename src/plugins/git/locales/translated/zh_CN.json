  "permissions": {
    "use": {
      "title": "使用 Git",
      "description": "查看您可访问主机上的 Git 仓库，并修改您可编辑主机上的仓库。"
    },
    "runCommands": {
      "title": "自动拉取后运行命令",
      "description": "设置一个在自动拉取引入新提交后在主机上运行的命令。"
    }
  },
  "settings": {
    "host": {
      "enable": {
        "label": "Git",
        "description": "从 Git 选项卡管理此主机上的 Git 仓库。"
      },
      "repoRoots": {
        "label": "扫描文件夹",
        "description": "扫描此主机时搜索仓库的文件夹。用逗号分隔。默认为主文件夹。",
        "placeholder": "~/projects, /opt"
      },
      "useSudo": {
        "label": "使用 sudo",
        "description": "使用 sudo 以 root 身份运行 git。仅适用于登录用户无法使用的仓库。"
      },
      "readOnly": {
        "label": "只读",
        "description": "显示仓库但从不在此主机上修改它们。"
      },
      "showPanel": {
        "label": "终端旁边的面板",
        "description": "在此主机的终端选项卡上提供 Git 面板。"
      }
