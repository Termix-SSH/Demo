{
  "id": "notes",
  "name": "Notes",
  "version": "1.0.0",
  "description": "Write markdown notes for each host, folder or yourself, with commands you can copy or send to the terminal.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Notes",
  "docs": "https://docs.termix.site/plugins/notes",
  "video": "https://www.youtube.com/watch?v=pfTDZqNbeBw",
  "category": "Productivity",
  "icon": "NotebookPen",
  "features": [
    "Many markdown notes per host, per folder or global",
    "Write and preview with a small toolbar",
    "Copy a command or send it to the open terminal",
    "Pin notes, add tags and search all notes",
    "A notes panel beside any SSH terminal"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.11.1-0",
    "api": "^1.15"
  },
  "capabilities": [
    "hosts:read",
    "events:core",
    "network:serve",
    "ui:surface",
    "db:own",
    "operations:provide"
  ],
  "contributes": {
    "tabs": [
      {
        "id": "notes",
        "titleKey": "tab.title",
        "icon": "NotebookPen",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "host": {
        "enableKey": "enableNotes",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "enableDefault": true,
        "editorGroup": "top",
        "fields": [
          {
            "key": "showPanel",
            "type": "boolean",
            "labelKey": "settings.host.showPanel.label",
            "descriptionKey": "settings.host.showPanel.description",
            "default": true,
            "requires": "enableNotes"
          }
        ]
      },
      "user": [
        {
          "key": "companionAutoOpen",
          "type": "boolean",
          "labelKey": "settings.user.companionAutoOpen.label",
          "descriptionKey": "settings.user.companionAutoOpen.description",
          "default": false
        },
        {
          "key": "companionSide",
          "type": "select",
          "labelKey": "settings.user.companionSide.label",
          "descriptionKey": "settings.user.companionSide.description",
          "default": "right",
          "options": [
            {
              "value": "right",
              "labelKey": "settings.user.companionSide.right"
            },
            {
              "value": "left",
              "labelKey": "settings.user.companionSide.left"
            },
            {
              "value": "bottom",
              "labelKey": "settings.user.companionSide.bottom"
            }
          ]
        },
        {
          "key": "companionSize",
          "type": "number",
          "labelKey": "settings.user.companionSize.label",
          "descriptionKey": "settings.user.companionSize.description",
          "min": 240,
          "max": 900,
          "default": 420
        },
        {
          "key": "companionEdgeButton",
          "type": "boolean",
          "labelKey": "settings.user.companionEdgeButton.label",
          "descriptionKey": "settings.user.companionEdgeButton.description",
          "default": true
        }
      ]
    },
    "operations": {
      "actions": [
        {
          "id": "notes.list",
          "titleKey": "operations.list.title",
          "scope": "host",
          "risk": "read",
          "permission": "use",
          "hostAccess": "connect",
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        },
        {
          "id": "notes.get",
          "titleKey": "operations.get.title",
          "scope": "host",
          "risk": "read",
          "permission": "use",
          "hostAccess": "connect",
          "inputs": [
            {
              "key": "note",
              "type": "select",
              "labelKey": "operations.note",
              "required": true,
              "optionsFrom": "notes.list"
            }
          ],
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        },
        {
          "id": "notes.create",
          "titleKey": "operations.create.title",
          "icon": "Plus",
          "scope": "host",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "inputs": [
            {
              "key": "title",
              "type": "string",
              "labelKey": "operations.title",
              "required": true
            },
            {
              "key": "body",
              "type": "string",
              "labelKey": "operations.body"
            }
          ],
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "notes.append",
          "titleKey": "operations.append.title",
          "icon": "TextCursorInput",
          "scope": "host",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "inputs": [
            {
              "key": "note",
              "type": "select",
              "labelKey": "operations.note",
              "required": true,
              "optionsFrom": "notes.list"
            },
            {
              "key": "text",
              "type": "string",
              "labelKey": "operations.text",
              "required": true
            }
          ],
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        }
      ],
      "signals": [
        {
          "id": "notes.count",
          "titleKey": "operations.count.title",
          "read": "notes.list",
          "scope": "host",
          "kind": "count"
        }
      ],
      "resources": [
        {
          "id": "notes.note",
          "titleKey": "operations.notes.title",
          "icon": "NotebookPen",
          "list": "notes.list",
          "key": "id",
          "name": "name",
          "tab": "notes",
          "columns": [
            {
              "key": "tags",
              "titleKey": "operations.notes.tags"
            },
            {
              "key": "pinned",
              "titleKey": "operations.notes.pinned"
            }
          ]
        }
      ]
    },
    "dashboardCards": [
      {
        "id": "notes-pinned",
        "titleKey": "card.title",
        "icon": "NotebookPen"
      }
    ]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
