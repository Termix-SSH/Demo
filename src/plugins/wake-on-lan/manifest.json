{
  "id": "wake-on-lan",
  "name": "Wake-on-LAN",
  "version": "1.2.0",
  "description": "Wake, shut down and track your machines from one power dashboard.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Wake-On-LAN",
  "docs": "https://docs.termix.site/plugins/wake-on-lan",
  "video": "https://www.youtube.com/watch?v=mGyiovySI5g",
  "category": "Networking",
  "icon": "Zap",
  "features": [
    "A Power tab with every machine, its status, last seen time and a power button",
    "Wake from the Termix server, or from any SSH host on the machine's network",
    "Shut down over SSH, with Sleep-On-LAN or with your own command",
    "Check status by port, ping or your own command",
    "Find machines with a network scan and attach them to existing hosts",
    "Wake and shut down on a schedule with cron",
    "Turn on over the network with a SecureON password",
    "A dashboard card and homepage widget with power buttons",
    "Wake a host before a remote desktop connection",
    "Wake a host from an automation"
  ],
  "engine": {
    "termix": ">=26.11.1-0",
    "api": "^1.13"
  },
  "capabilities": [
    "credentials:use",
    "db:own",
    "hosts:read",
    "hosts:write",
    "kv:own",
    "network:broadcast",
    "network:outbound",
    "network:probe",
    "network:serve",
    "notify:send",
    "operations:provide",
    "process:spawn",
    "secrets:own",
    "ssh:connect",
    "ui:surface",
    "users:impersonate"
  ],
  "provides": [
    {
      "service": "wake-on-lan.send",
      "version": "1.0.0",
      "permission": "wake-on-lan.send"
    }
  ],
  "contributes": {
    "permissions": [
      {
        "name": "send",
        "titleKey": "permissions.send.title",
        "descriptionKey": "permissions.send.description",
        "defaultRoles": ["admin", "user"]
      },
      {
        "name": "shutdown",
        "titleKey": "permissions.shutdown.title",
        "descriptionKey": "permissions.shutdown.description",
        "defaultRoles": ["admin", "user"]
      },
      {
        "name": "scan",
        "titleKey": "permissions.scan.title",
        "descriptionKey": "permissions.scan.description",
        "defaultRoles": ["admin", "user"]
      },
      {
        "name": "server-commands",
        "titleKey": "permissions.serverCommands.title",
        "descriptionKey": "permissions.serverCommands.description",
        "defaultRoles": ["admin"]
      }
    ],
    "settings": {
      "host": {
        "enableKey": "enablePower",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "enableDefault": false,
        "editorGroup": "top",
        "editorOrder": 90,
        "fields": [
          {
            "key": "macAddress",
            "type": "string",
            "labelKey": "settings.host.macAddress.label",
            "descriptionKey": "settings.host.macAddress.description",
            "placeholderKey": "settings.host.macAddress.placeholder",
            "defaultable": false,
            "requires": "enablePower"
          },
          {
            "key": "broadcastAddress",
            "type": "string",
            "labelKey": "settings.host.broadcastAddress.label",
            "descriptionKey": "settings.host.broadcastAddress.description",
            "placeholderKey": "settings.host.broadcastAddress.placeholder",
            "requires": "enablePower"
          }
        ]
      },
      "admin": [
        {
          "key": "statusInterval",
          "type": "number",
          "labelKey": "settings.admin.statusInterval.label",
          "descriptionKey": "settings.admin.statusInterval.description",
          "min": 15,
          "max": 3600,
          "default": 60
        },
        {
          "key": "allowServerCommands",
          "type": "boolean",
          "labelKey": "settings.admin.allowServerCommands.label",
          "descriptionKey": "settings.admin.allowServerCommands.description",
          "default": false
        }
      ]
    },
    "dashboardCards": [
      {
        "id": "wake-on-lan",
        "titleKey": "card.title",
        "icon": "Power"
      }
    ],
    "tabs": [
      {
        "id": "power",
        "titleKey": "tab.title",
        "icon": "Power",
        "openFrom": ["rail", "palette"]
      }
    ],
    "uses": ["homepage.widgets"],
    "operations": {
      "actions": [
        {
          "id": "wake-on-lan.wake",
          "titleKey": "operations.wake.title",
          "icon": "Power",
          "scope": "host",
          "risk": "change",
          "permission": "send",
          "hostAccess": "connect",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enablePower": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "wake-on-lan.shutdown",
          "titleKey": "operations.shutdown.title",
          "icon": "PowerOff",
          "scope": "host",
          "risk": "change",
          "permission": "shutdown",
          "hostAccess": "connect",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enablePower": true
            }
          },
          "surfaces": {
            "assistant": true
          }
        },
        {
          "id": "wake-on-lan.sleep",
          "titleKey": "operations.sleep.title",
          "icon": "Moon",
          "scope": "host",
          "risk": "change",
          "permission": "shutdown",
          "hostAccess": "connect",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enablePower": true
            }
          },
          "surfaces": {
            "assistant": true
          }
        },
        {
          "id": "wake-on-lan.power-state",
          "titleKey": "operations.powerState.title",
          "scope": "host",
          "risk": "read",
          "permission": "send",
          "hostAccess": "connect",
          "when": {
            "settings": {
              "enablePower": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        }
      ],
      "signals": [
        {
          "id": "wake-on-lan.power",
          "titleKey": "operations.powerState.title",
          "read": "wake-on-lan.power-state",
          "scope": "host",
          "kind": "status",
          "refreshSec": 60,
          "fix": "wake-on-lan.wake"
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
