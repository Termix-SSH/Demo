{
  "id": "classic-themes",
  "name": "Classic Themes",
  "version": "1.0.0",
  "description": "Light, dark and seven more color themes for Termix.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Classic-Themes",
  "docs": "https://docs.termix.site/plugins/classic-themes",
  "video": "https://www.youtube.com/watch?v=qjIa8pM3k08",
  "category": "Productivity",
  "icon": "Palette",
  "features": [
    "Light and dark themes",
    "Dracula, Catppuccin, Nord, Solarized, Tokyo Night, One Dark and Gruvbox"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.10.3",
    "api": "^1.4"
  },
  "capabilities": ["ui:theme"],
  "contributes": {
    "themes": [
      {
        "id": "dark",
        "label": "theme.dark",
        "mode": "dark",
        "css": "themes/dark.css",
        "swatch": {
          "background": "#1a1c22",
          "panel": "#25272e",
          "text": "#e5e7eb"
        }
      },
      {
        "id": "light",
        "label": "theme.light",
        "mode": "light",
        "css": "themes/light.css",
        "swatch": {
          "background": "#ffffff",
          "panel": "#eef0f3",
          "text": "#1f2937"
        }
      },
      {
        "id": "dracula",
        "label": "theme.dracula",
        "mode": "dark",
        "css": "themes/dracula.css",
        "swatch": {
          "background": "#282a36",
          "panel": "#44475a",
          "text": "#f8f8f2"
        }
      },
      {
        "id": "catppuccin",
        "label": "theme.catppuccin",
        "mode": "dark",
        "css": "themes/catppuccin.css",
        "swatch": {
          "background": "#1e1e2e",
          "panel": "#313244",
          "text": "#cdd6f4"
        }
      },
      {
        "id": "nord",
        "label": "theme.nord",
        "mode": "dark",
        "css": "themes/nord.css",
        "swatch": {
          "background": "#2e3440",
          "panel": "#3b4252",
          "text": "#eceff4"
        }
      },
      {
        "id": "solarized",
        "label": "theme.solarized",
        "mode": "dark",
        "css": "themes/solarized.css",
        "swatch": {
          "background": "#002b36",
          "panel": "#073642",
          "text": "#93a1a1"
        }
      },
      {
        "id": "tokyo-night",
        "label": "theme.tokyoNight",
        "mode": "dark",
        "css": "themes/tokyo-night.css",
        "swatch": {
          "background": "#1a1b26",
          "panel": "#24283b",
          "text": "#c0caf5"
        }
      },
      {
        "id": "one-dark",
        "label": "theme.oneDark",
        "mode": "dark",
        "css": "themes/one-dark.css",
        "swatch": {
          "background": "#282c34",
          "panel": "#21252b",
          "text": "#abb2bf"
        }
      },
      {
        "id": "gruvbox",
        "label": "theme.gruvbox",
        "mode": "dark",
        "css": "themes/gruvbox.css",
        "swatch": {
          "background": "#282828",
          "panel": "#3c3836",
          "text": "#ebdbb2"
        }
      }
    ]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
