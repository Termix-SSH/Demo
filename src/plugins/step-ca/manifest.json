{
  "id": "step-ca",
  "name": "Step CA",
  "version": "1.0.0",
  "description": "Connect to hosts with short-lived SSH certificates from a smallstep step-ca server.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Step-CA",
  "docs": "https://docs.termix.site/plugins/step-ca",
  "category": "Access & Security",
  "icon": "ShieldCheck",
  "features": [
    "Adds the Step CA auth type to hosts",
    "Sign in with your identity provider in the browser",
    "Certificates are kept until they expire",
    "No step binary needed"
  ],
  "env": [
    {
      "name": "REDIS_URL",
      "description": "Redis that several Termix servers share for sign in state. Not needed with one server."
    },
    {
      "name": "TERMIX_STEP_CA_REDIS_PREFIX",
      "description": "Prefix for the keys it writes in Redis.",
      "default": "termix:step-ca"
    }
  ],
  "engine": {
    "termix": ">=26.10.0",
    "api": "^1.2"
  },
  "capabilities": [
    "db:own",
    "secrets:own",
    "network:outbound",
    "network:serve",
    "auth:provide",
    "ui:surface"
  ],
  "contributes": {
    "auth": {
      "sshAuthTypes": ["stepca"]
    },
    "settings": {
      "admin": [
        {
          "key": "caUrl",
          "type": "string",
          "labelKey": "settings.caUrl.label",
          "descriptionKey": "settings.caUrl.description",
          "placeholderKey": "settings.caUrl.placeholder",
          "default": ""
        },
        {
          "key": "fingerprint",
          "type": "string",
          "labelKey": "settings.fingerprint.label",
          "descriptionKey": "settings.fingerprint.description",
          "default": ""
        },
        {
          "key": "provisioner",
          "type": "string",
          "labelKey": "settings.provisioner.label",
          "descriptionKey": "settings.provisioner.description",
          "default": ""
        },
        {
          "key": "privateEndpoints",
          "type": "textarea",
          "labelKey": "settings.privateEndpoints.label",
          "descriptionKey": "settings.privateEndpoints.description",
          "default": ""
        },
        {
          "key": "redirectUri",
          "type": "custom",
          "component": "redirectUri"
        }
      ]
    },
    "uses": ["terminal.overlay"]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
