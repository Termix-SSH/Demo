{
  "id": "fleets",
  "name": "Fleets",
  "version": "1.2.0",
  "description": "Group hosts into fleets and run commands, package actions and file transfers on all of them at once.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Fleets",
  "docs": "https://docs.termix.site/plugins/fleets",
  "video": "https://www.youtube.com/watch?v=WnQLS1N6oIA",
  "category": "Infrastructure",
  "icon": "Boxes",
  "features": [
    "Group hosts by hand or with tag rules, so new hosts join on their own",
    "Run one command on every host and see each result",
    "Install, remove or upgrade packages across the fleet",
    "Push and pull files on every host",
    "Collect an inventory of OS, kernel, architecture and uptime",
    "Share a fleet with users or roles"
  ],
  "engine": {
    "termix": ">=26.11.1-0",
    "api": "^1.15"
  },
  "capabilities": [
    "hosts:read",
    "hosts:write",
    "credentials:use",
    "credentials:read",
    "ssh:connect",
    "db:own",
    "network:serve",
    "ui:surface",
    "operations:provide"
  ],
  "optionalDependencies": {
    "snippets": "^1.0.0"
  },
  "provides": [
    {
      "service": "fleets.access",
      "version": "1.0.0",
      "permission": "fleets.view"
    }
  ],
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"],
  "contributes": {
    "syncEntities": ["fleets"],
    "tabs": [
      {
        "id": "fleet-inventory",
        "titleKey": "nav.fleets",
        "icon": "Boxes",
        "openFrom": ["rail"]
      }
    ],
    "panels": [
      {
        "id": "fleets",
        "titleKey": "nav.fleets",
        "icon": "Boxes"
      }
    ],
    "permissions": [
      {
        "name": "view",
        "titleKey": "permissions.view.title",
        "descriptionKey": "permissions.view.description",
        "defaultRoles": ["user"]
      },
      {
        "name": "manage",
        "titleKey": "permissions.manage.title",
        "descriptionKey": "permissions.manage.description",
        "defaultRoles": ["user"]
      },
      {
        "name": "execute",
        "titleKey": "permissions.execute.title",
        "descriptionKey": "permissions.execute.description",
        "defaultRoles": ["user"]
      }
    ],
    "uses": ["snippets.extractInputs", "snippets.list"],
    "settings": {
      "user": [
        {
          "key": "alwaysShowActions",
          "type": "boolean",
          "labelKey": "settings.alwaysShowActions.label",
          "descriptionKey": "settings.alwaysShowActions.description",
          "default": false
        }
      ],
      "admin": [
        {
          "key": "connectRetries",
          "type": "number",
          "labelKey": "settings.connectRetries.label",
          "descriptionKey": "settings.connectRetries.description",
          "default": 2,
          "min": 0,
          "max": 10
        },
        {
          "key": "connectRetryDelay",
          "type": "number",
          "labelKey": "settings.connectRetryDelay.label",
          "descriptionKey": "settings.connectRetryDelay.description",
          "default": 5,
          "min": 1,
          "max": 300
        }
      ]
    },
    "operations": {
      "actions": [
        {
          "id": "fleets.list-fleets",
          "titleKey": "operations.listFleets.title",
          "scope": "server",
          "risk": "read",
          "permission": "view",
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        },
        {
          "id": "fleets.run-command",
          "titleKey": "operations.runCommand.title",
          "descriptionKey": "operations.runCommand.description",
          "icon": "TerminalSquare",
          "scope": "host",
          "inputs": [
            {
              "key": "command",
              "type": "textarea",
              "labelKey": "operations.runCommand.command",
              "required": true
            }
          ],
          "risk": "change",
          "permission": "execute",
          "hostAccess": "edit",
          "dryRun": "describe",
          "timeoutMs": 600000,
          "surfaces": {
            "palette": false
          }
        }
      ]
    },
    "dashboardCards": [
      {
        "id": "fleets",
        "titleKey": "nav.fleets",
        "icon": "Boxes"
      }
    ]
  }
}
